# Local output: `npm run texts:export` writes outputs/app-texts-fi-en/ (four
# megabytes that change with every line of copy; the script rebuilds them in
# half a minute), and the rest is review material such as competitor notes and
# QA screenshots. None of it is tracked.
/outputs/
# Company brand marks and design handoffs live beside the checkout, not in it.
/brand/
/Design_handoff/
# Private notes (lawyer memos, company papers): the repository is public.
private/
docs/legal/juristin-*
