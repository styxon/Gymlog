{
  "name": "vinha",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:unit": "node tests/run-tests.cjs",
    "texts:export": "tsc -p tsconfig.test.json && node scripts/export-app-texts.cjs",
    "exercise:sync": "node scripts/generate_free_exercise_library.mjs",
    "slack:notify": "node scripts/slackNotify.cjs",
    "android:release": "node -e \"const cp=require('child_process');const path=require('path');const bin=process.platform==='win32'?path.join(process.cwd(),'android','gradlew.bat'):'./gradlew';const result=cp.spawnSync(bin,['assembleRelease'],{cwd:'android',stdio:'inherit',shell:true,env:{...process.env,CI:'1'}});process.exit(result.status ?? 1)\"",
    "measure:startup": "node scripts/measureStartup.cjs",
    "release:ios": "node scripts/releaseGuard.cjs --platform ios && eas build -p ios --profile production",
    "release:ios:done": "node scripts/releaseGuard.cjs --platform ios --mark",
    "release:android": "node scripts/releaseGuard.cjs --platform android && npm run android:release",
    "release:android:done": "node scripts/releaseGuard.cjs --platform android --mark"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@vercel/blob": "^2.8.0",
    "expo": "~55.0.6",
    "expo-apple-authentication": "~55.0.8",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-keep-awake": "~55.0.8",
    "expo-notifications": "~55.0.27",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.8",
    "fflate": "^0.8.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
